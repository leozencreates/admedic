# ---------------------------------------------------------------------------
# Admedic — ortam değişkenleri (kök .env; tüm paketler bu dosyayı okur)
# Gizli değerleri asla koda/teste yazmayın. Üretimde AUTH_SECRET/ENCRYPTION_KEY zorunludur.
# ---------------------------------------------------------------------------

# Ürün adı — kodda sabit yazılmaz; panel, API servis adı ve masaüstü productName buradan gelir.
APP_NAME="Klinik Reklam Stüdyosu"
NODE_ENV=""                # development | test | production (boş → development)
LOG_LEVEL=""               # debug | info | warn | error (varsayılan info)

DATABASE_URL="postgresql://admedic:admedic@localhost:5432/admedic_dev"
# Kullanılmıyor: webhook kuyruğu PostgreSQL'de (ADR-0023). Boş bırakın.
REDIS_URL=""
# Web sürecindeki arka plan süpürücüsü (işlenemeyen Meta webhook'larını yeniden dener, ADR-0023).
# Boş → üretimde açık, geliştirmede kapalı; "on" / "off" ile zorlanır.
BACKGROUND_JOBS=""

# Panel origin'i; yazma isteklerinde origin kontrolü ve apps/api CORS için kullanılır.
AUTH_URL="http://localhost:3000"
# Rastgele güçlü bir değer (örn. `openssl rand -hex 32`). Üretimde geliştirme varsayılanı reddedilir.
AUTH_SECRET=""
# Alan seviyesinde şifreleme (spec 3.11): 64 hex karakter = 32 byte (`openssl rand -hex 32`).
# Meta token'ları ve lead telefon/e-posta alanları bu anahtarla AES-256-GCM ile şifrelenir.
ENCRYPTION_KEY=""

# ---- Meta -----------------------------------------------------------------
# true → Meta Marketing API, WhatsApp, Messenger ve CAPI çağrıları mock'lanır; hiçbir gerçek istek yapılmaz.
# Üretimde (NODE_ENV=production) açıkça "false" olmalı; demo sunucusu için ALLOW_MOCK_IN_PRODUCTION=true.
META_MOCK_MODE="true"
ALLOW_MOCK_IN_PRODUCTION=""
META_APP_ID=""
META_APP_SECRET=""
# Boşsa varsayılan: http://localhost:3000/api/meta/oauth/callback
META_REDIRECT_URI=""
# Graph API sürümü — koda sabit yazılmaz (örn. v26.0). META_GRAPH_API_VERSION doluysa o öncelikli.
META_API_VERSION="v26.0"
META_GRAPH_API_VERSION=""
# Webhook imzası (X-Hub-Signature-256). Meta, App Secret ile imzalar; boşsa META_APP_SECRET kullanılır.
META_WEBHOOK_SECRET=""
# Webhook abonelik doğrulaması (hub.verify_token) — Meta uygulama panelinde girilen değerle aynı olmalı.
META_WEBHOOK_VERIFY_TOKEN=""
# Bağlantı koptuğunda bilgilendirilecek dış webhook (opsiyonel; POST / JSON)
META_DISCONNECTED_WEBHOOK_URL=""

# ---- WhatsApp Cloud API (opsiyonel; META_MOCK_MODE=true iken gerçek gönderim yapılmaz) ----
WHATSAPP_API_URL=""        # örn. https://graph.facebook.com/v26.0/<PHONE_NUMBER_ID>
WHATSAPP_TOKEN=""
# 24 saat penceresi dışındaki karşılama için Meta'da onaylı şablon adı (küçük harf/alt çizgi)
WHATSAPP_GREETING_TEMPLATE=""

# ---- Salt okunur Fastify API (apps/api) — isteğe bağlı; masaüstü kabuğu artık paneli açar (ADR-0025) ----
API_URL="http://127.0.0.1:3001"
# Bearer belirteci; boşsa API yalnız META_MOCK_MODE=true iken cevap verir (aksi halde 503).
API_TOKEN=""
PORT="3001"
API_HOST="127.0.0.1"

# ---- Sesli ajanla giden arama (ElevenLabs, ADR-0026) — isteğe bağlı ----
# İlk üçü ayarlanmadıkça arama başlatılamaz; META_MOCK_MODE=true iken gerçek arama yapılmaz.
# Kurulum adımları: docs/runbook.md "Sesli arama". Canlı aramadan önce: docs/elevenlabs-constraints.md "Şartlar".
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
# ElevenLabs'e aktarılan telefon numarasının kimliği (phone_number_id)
ELEVENLABS_PHONE_NUMBER_ID=""
# Arama sonu webhook'unun HMAC gizli anahtarı; boşsa /api/webhooks/elevenlabs her isteği 401 ile reddeder.
ELEVENLABS_WEBHOOK_SECRET=""
# Numaranın bağlanma biçimi: twilio (varsayılan) | sip_trunk
ELEVENLABS_TELEPHONY=""
# Boşsa https://api.elevenlabs.io; AB veri konumu hesabında https://api.eu.residency.elevenlabs.io
ELEVENLABS_API_BASE=""

# ---- Panel içi sesli komut asistanı (ElevenLabs Agents, ADR-0028) — isteğe bağlı ----
# Personelin sesi ElevenLabs'te işlenir. Yukarıdaki ELEVENLABS_API_KEY / ELEVENLABS_API_BASE kullanılır;
# anahtar tarayıcıya gönderilmez. META_MOCK_MODE=true iken sahte oturum döner, dış istek yapılmaz.
# true | false (varsayılan false). Acil kapatma: false.
VOICE_ASSISTANT_ENABLED=""
# Asistan ajanı (telefon ajanı ELEVENLABS_AGENT_ID'den ayrı)
ELEVENLABS_ASSISTANT_AGENT_ID=""
# webrtc (varsayılan) | websocket
ELEVENLABS_ASSISTANT_CONNECTION=""
# us (varsayılan) | eu-residency | in-residency | global — residency için ELEVENLABS_API_BASE aynı bölge olmalı
ELEVENLABS_SERVER_LOCATION=""
# Asistanın adı; boşsa APP_NAME
ASSISTANT_NAME=""
# İsteğe bağlı ses geçersiz kılması; boşsa ajanda seçili ses
ELEVENLABS_ASSISTANT_VOICE_ID=""
# Oturumun en uzun süresi, saniye (60–1800; boşsa 300). Ajana assistant:sync-agent ile eşitlenir.
VOICE_ASSISTANT_MAX_SESSION_SECONDS=""
# Kuruluş başına günlük (UTC) en çok oturum; 0 = sınırsız (boşsa 200)
VOICE_ASSISTANT_DAILY_SESSIONS_PER_ORG=""
# Kuruluş başına aylık dakika bütçesi; boş ya da 0 = sınırsız. Maliyet izleme: docs/runbook.md
VOICE_ASSISTANT_MONTHLY_MINUTES_PER_ORG=""

# ---- LLM (Anthropic) — anahtar ve model ortamdan gelir; varsayılan model yoktur ----
ANTHROPIC_API_KEY=""
LLM_MODEL=""

# ---- Stripe (faturalandırma, spec 3.12) ----
# Boşsa (production dışında) faturalandırma mock/ödeme simülasyonu modunda çalışır.
STRIPE_SECRET_KEY=""
# Webhook imza doğrulaması — imzalı istek için zorunlu (yoksa 401).
STRIPE_WEBHOOK_SECRET=""
# Plan başına Stripe Price kimlikleri (checkout)
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_ENTERPRISE=""
# Boşsa varsayılan: ${AUTH_URL}/billing?status=paid ve ...?status=cancel
STRIPE_SUCCESS_URL=""
STRIPE_CANCEL_URL=""

# ---- Haftalık rapor (Resend) ----
RESEND_API_KEY=""
RESEND_FROM=""             # örn. "Klinik Reklam Stüdyosu <raporlar@alanadiniz.com>"
# Ortam düzeyi varsayılan alıcı; Organization.reportRecipient (org ayarları) önceliklidir.
WEEKLY_REPORT_RECIPIENT=""
# 0=Pazar … 6=Cumartesi (UTC)
WEEKLY_REPORT_DAY="0"

# ---- İlk kullanıcı CLI'ı: pnpm --filter @admedic/web user:create ----
# İşlemden sonra BOOTSTRAP_PASSWORD değerini ortamdan kaldırın.
BOOTSTRAP_EMAIL=""
BOOTSTRAP_PASSWORD=""
BOOTSTRAP_CLINIC=""
