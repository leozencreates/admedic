WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER=""
META_WEBHOOK_SECRET=""
# Meta Business Login (OAuth) — bağlantı sayfası için gerekli
META_APP_ID=""
META_APP_SECRET=""
# META_REDIRECT_URI varsayılanı: http://localhost:3000/api/meta/oauth/callback
META_REDIRECT_URI=""
# Meta Graph API sürümü; sabit yazılmaz (örn. v26.0)
META_API_VERSION="v26.0"
# Modern adlandırma (META_API_VERSION üzerine önceliklidir)
META_GRAPH_API_VERSION=""
# Bağlantı koptuğunda bilgilendirilecek dış webhook (opsiyonel; POST / JSON)
META_DISCONNECTED_WEBHOOK_URL=""
# Alan seviyesinde şifreleme (P0 - spec 3.11)
ENCRYPTION_KEY=""
# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SUCCESS_URL=""
STRIPE_CANCEL_URL=""
