APP_NAME="Klinik Reklam Stüdyosu"
DATABASE_URL="postgresql://localhost:5432/admedic_dev"
AUTH_URL="http://localhost:3000"
# Rastgele güçlü bir değer ile değiştirin.
AUTH_SECRET=""
META_MOCK_MODE="true"
ANTHROPIC_API_KEY=""
LLM_MODEL=""
# İlk kullanıcı CLI'ı: pnpm --filter @admedic/web user:create
# İşlemden sonra BOOTSTRAP_PASSWORD değerini ortamdan kaldırın.
BOOTSTRAP_EMAIL=""
BOOTSTRAP_PASSWORD=""
BOOTSTRAP_CLINIC=""
# WhatsApp Cloud API (opsiyonel). META_MOCK_MODE=true ise gerçek gönderim yerine mock döner.
