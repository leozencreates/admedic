# Admedic üretim ortamı (ADR-0023). Bu dosyayı deploy/.env olarak kopyalayıp doldurun; depoya EKLEMEYİN.
# Gizli değer üretmek için: openssl rand -hex 32

# ---- Adres ve HTTPS ----
DOMAIN=panel.ornek-alanadi.com.tr
ACME_EMAIL=teknik@ornek-alanadi.com.tr
AUTH_URL=https://panel.ornek-alanadi.com.tr
APP_NAME=Admedic
APP_VERSION=

# ---- Veritabanı (compose içindeki postgres) ----
POSTGRES_USER=admedic
POSTGRES_PASSWORD=
POSTGRES_DB=admedic

# ---- Gizli anahtarlar ----
# AUTH_SECRET: oturum imzası (en az 32 karakter). ENCRYPTION_KEY: 64 hex (kişisel veri şifreleme; KAYBETMEYİN,
# değişirse şifreli alanlar okunamaz — yedekle birlikte ayrı ve güvenli bir yerde saklayın).
AUTH_SECRET=
ENCRYPTION_KEY=

# ---- Meta ----
META_MOCK_MODE=false
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v26.0
META_REDIRECT_URI=https://panel.ornek-alanadi.com.tr/api/meta/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=
# WhatsApp: bağlantı başına eşleme yoksa kullanılan ortam düzeyi numara (çok kiracılıda boş bırakın).
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_GREETING_TEMPLATE=

# ---- Yapay zekâ (asistan, kreatif) ----
ANTHROPIC_API_KEY=
LLM_MODEL=

# ---- E-posta raporu (isteğe bağlı) ----
RESEND_API_KEY=
RESEND_FROM=
WEEKLY_REPORT_DAY=

# ---- Günlük ----
LOG_LEVEL=info
# Web sürecindeki arka plan süpürücüsü (webhook yeniden deneme); üretimde varsayılan açık.
BACKGROUND_JOBS=on
