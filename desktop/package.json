{
  "name": "@admedic/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Admedic Masaüstü kabuğu (Tauri v2, ADR-0003) — web panelini host eder; veri ortak REST'ten",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "typecheck": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:ci": "tauri build --config '{\"productName\":\"'$APP_NAME'\"}'"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  }
}
