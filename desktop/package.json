{
  "name": "@admedic/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Masaüstü kabuğu (Tauri v2, ADR-0003) — salt okunur Fastify REST'i (apps/api) tüketen statik panel; ürün adı build:ci ile APP_NAME'den gelir",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "typecheck": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:ci": "tauri build --config \"{\\\"productName\\\":\\\"$APP_NAME\\\"}\""
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  }
}
