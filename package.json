{
  "name": "admedic",
  "version": "0.1.0",
  "private": true,
  "description": "Admedic - AI health tourism Meta Ads optimization platform (Test Lab + ROAS Autopilot, monorepo)",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @admedic/database prisma:generate",
    "db:migrate": "pnpm --filter @admedic/database db:migrate",
    "db:deploy": "pnpm --filter @admedic/database db:deploy",
    "db:seed": "pnpm --filter @admedic/database db:seed",
    "db:studio": "pnpm --filter @admedic/database db:studio",
    "api:dev": "pnpm --filter @admedic/api dev",
    "web:dev": "pnpm --filter @admedic/web dev",
    "test-lab:dev": "pnpm --filter @admedic/test-lab dev",
    "autopilot:dev": "pnpm --filter @admedic/roas-autopilot dev",
    "worker:sync": "pnpm --filter @admedic/worker-meta-sync start",
    "worker:opt": "pnpm --filter @admedic/worker-optimization start",
    "worker:exp": "pnpm --filter @admedic/worker-experiments start",
    "worker:report": "pnpm --filter @admedic/worker-reporting start",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.6",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  }
}