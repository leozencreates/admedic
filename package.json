{
  "name": "admedic",
  "version": "0.1.0",
  "private": true,
  "description": "Sağlık turizmi klinikleri için insan onaylı Meta reklam ajanı platformu (çalışma adı Admedic; ürün adı APP_NAME ortam değişkeninden) — pnpm + Turborepo monorepo: Next.js panel, Prisma/PostgreSQL, Meta senkron worker'ı, salt okunur Fastify API ve Tauri masaüstü kabuğu",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "turbo run typecheck lint test --filter=!@admedic/desktop --env-mode=loose --continue",
    "test:e2e": "turbo run test:e2e --filter=@admedic/web",
    "db:generate": "pnpm --filter @admedic/database prisma:generate",
    "db:migrate": "pnpm --filter @admedic/database db:migrate",
    "db:deploy": "pnpm --filter @admedic/database db:deploy",
    "db:seed": "pnpm --filter @admedic/database db:seed",
    "db:studio": "pnpm --filter @admedic/database db:studio",
    "api:dev": "pnpm --filter @admedic/api dev",
    "web:dev": "pnpm --filter @admedic/web dev",
    "desktop:dev": "pnpm --filter @admedic/desktop dev",
    "worker:sync": "pnpm --filter @admedic/meta-sync start",
    "assistant:sync-agent": "pnpm --filter @admedic/web assistant:sync-agent",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.6",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  }
}
